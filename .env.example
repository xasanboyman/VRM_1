# ==============================
# AI Model API Key (Server Side Only - No VITE_ Prefix)
# ==============================
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# ==============================
# Render Performance
# ==============================
VITE_RENDER_ANTIALIAS=true
VITE_RENDER_ALPHA=true
VITE_RENDER_SHADOWS=false
VITE_RENDER_POWER_PREFERENCE=high-performance
VITE_RENDER_PIXEL_RATIO_CAP=2
# Supersampling multiplier for extra-crisp output (1 = off). 1.25–1.5 is a great
# quality/perf trade-off on lower-DPI screens; values >1.5 get expensive.
VITE_RENDER_SUPERSAMPLE=1

# ==============================
# Telegram Bot Bridge
# ==============================
VITE_TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_RELAY_BASE_URL=/api/telegram
TELEGRAM_CHAT_ID=your_chat_id_in_telegram
VITE_TELEGRAM_SEND_VIDEO=true
VITE_TELEGRAM_SEND_IMAGE=true
VITE_TELEGRAM_SEND_LOGS=true
VITE_TELEGRAM_CONTINUOUS_VISION_FORWARDING=true
VITE_TELEGRAM_VISION_CLIP_SECONDS=30
VITE_TELEGRAM_VISION_INTERVAL_SECONDS=30
VITE_TELEGRAM_LOG_TIMEZONE=Asia/Tashkent

# ==============================
# Web App Gate
# ==============================
VITE_WEB_APP=true

# ==============================
# Speech2Motion & Audio2Face Backends (Oracle Cloud WebSockets)
# ==============================
VITE_SPEECH2MOTION_URL=https://xn--dr8haa.uz/oracle/speech2motion
VITE_SPEECH2MOTION_WS_URL=wss://xn--dr8haa.uz/oracle/speech2motion/api/v3/streaming_speech2motion/ws
VITE_AUDIO2FACE_URL=https://xn--dr8haa.uz/oracle/audio2face
VITE_AUDIO2FACE_WS_URL=wss://xn--dr8haa.uz/oracle/audio2face/api/v1/streaming_audio2face/ws

